# Required. URL of your Grocy instance, including any base path.
GROCY_BASE_URL='https://grocy.example.com'
# Required. Create an API key in Grocy: Manage API keys.
GROCY_API_KEY=''
# Optional upstream request timeout in milliseconds.
GROCY_TIMEOUT_MS=15000
# Optional identifier sent to Grocy.
GROCY_USER_AGENT='GrocyMCP/0.1 (+https://github.com/thijserven/grocy-mcp)'

# Required only by the Streamable HTTP entrypoint (dist/http-entry.js).
GROCY_MCP_AUTH_TOKEN=''
GROCY_MCP_HOST='0.0.0.0'
GROCY_MCP_PORT=3000
